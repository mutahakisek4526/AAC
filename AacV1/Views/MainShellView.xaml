<Window x:Class="AacV1.Views.MainShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AacV1 視線・スイッチAAC" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="MinHeight" Value="70"/>
            <EventSetter Event="MouseEnter" Handler="OnSelectableMouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnSelectableMouseLeave"/>
            <EventSetter Event="Loaded" Handler="OnSelectableLoaded"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#101010">
        <StatusBar DockPanel.Dock="Bottom" FontSize="18">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" FontSize="44" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                <TextBlock Text="予測候補" Foreground="White" FontSize="24" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding PredictionItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Click="OnPredictionClick"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar x:Name="DwellProgressBar" Height="14" Maximum="1" Value="0" Margin="4"/>
            </StackPanel>

            <TabControl Grid.Row="2" x:Name="MainTabControl" SelectionChanged="OnTabChanged" FontSize="24">
                <TabItem Header="かな">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding KanaKeys}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Click="OnKanaClick"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Grid.Row="1">
                            <Button Content="削除" Click="OnBackspaceClick"/>
                            <Button Content="戻る" Click="OnUndoClick"/>
                            <Button Content="全消し" Click="OnClearClick"/>
                            <Button Content="改行" Click="OnNewLineClick"/>
                            <Button Content="確定" Click="OnCommitClick"/>
                            <Button Content="読み上げ" Click="OnSpeakClick"/>
                            <Button Content="停止" Click="OnStopClick"/>
                            <Button Content="履歴" Click="OnOpenHistoryTabClick"/>
                            <Button Content="定型文" Click="OnOpenPhraseTabClick"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="定型文">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <ComboBox ItemsSource="{Binding CategoryItems}" SelectedItem="{Binding SelectedCategory}" Height="44"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding PhraseItems}" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Click="OnPhraseClick" HorizontalContentAlignment="Left"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="履歴">
                    <ListBox ItemsSource="{Binding HistoryItems}" Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Text}" Click="OnHistoryClick" HorizontalContentAlignment="Left"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="操作(PC)">
                    <WrapPanel Margin="8">
                        <Button Content="↑" Click="OnPcKeyClick" Tag="Up"/>
                        <Button Content="↓" Click="OnPcKeyClick" Tag="Down"/>
                        <Button Content="←" Click="OnPcKeyClick" Tag="Left"/>
                        <Button Content="→" Click="OnPcKeyClick" Tag="Right"/>
                        <Button Content="Enter" Click="OnPcKeyClick" Tag="Enter"/>
                        <Button Content="Esc" Click="OnPcKeyClick" Tag="Escape"/>
                        <Button Content="Tab" Click="OnPcKeyClick" Tag="Tab"/>
                        <Button Content="Alt+Tab" Click="OnPcKeyClick" Tag="AltTab"/>
                        <Button Content="Win+D" Click="OnPcKeyClick" Tag="WinD"/>
                        <Button Content="音量+" Click="OnPcKeyClick" Tag="VolumeUp"/>
                        <Button Content="音量-" Click="OnPcKeyClick" Tag="VolumeDown"/>
                        <Button Content="ミュート" Click="OnPcKeyClick" Tag="Mute"/>
                        <Button Content="左クリック" Click="OnPcLeftClick"/>
                        <Button Content="マウス↑" Click="OnPcMoveClick" Tag="0,-30"/>
                        <Button Content="マウス↓" Click="OnPcMoveClick" Tag="0,30"/>
                        <Button Content="マウス←" Click="OnPcMoveClick" Tag="-30,0"/>
                        <Button Content="マウス→" Click="OnPcMoveClick" Tag="30,0"/>
                    </WrapPanel>
                </TabItem>

                <TabItem Header="設定">
                    <StackPanel Margin="8">
                        <TextBlock Text="入力方式" Foreground="White"/>
                        <ComboBox ItemsSource="{Binding InputModes}" SelectedItem="{Binding SelectedInputMode}" Width="280"/>
                        <TextBlock Text="ドウェル時間(ms)" Foreground="White" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding DwellMilliseconds}" Width="160"/>
                        <TextBlock Text="スキャン速度(ms)" Foreground="White" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding ScanIntervalMilliseconds}" Width="160"/>
                        <CheckBox Content="行列スキャン" IsChecked="{Binding UseRowColumnScan}" Foreground="White"/>
                        <CheckBox Content="2スイッチモード" IsChecked="{Binding UseTwoSwitchMode}" Foreground="White"/>
                        <CheckBox Content="ハイコントラスト" IsChecked="{Binding HighContrast}" Foreground="White"/>
                        <Button Content="設定を適用" Click="OnApplySettingsClick" Width="220"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="支援者">
                    <StackPanel Margin="8">
                        <Button Content="支援者モード切替" Click="OnToggleSupporterModeClick" Width="260"/>
                        <TextBlock Text="カテゴリ" Foreground="White" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding SupporterCategory}" Width="240"/>
                        <TextBlock Text="定型文" Foreground="White" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding SupporterPhraseText}" Width="600"/>
                        <WrapPanel>
                            <Button Content="定型文を追加" Click="OnSupporterAddPhraseClick" Width="220"/>
                            <Button Content="入力文と一致する定型文を削除" Click="OnSupporterDeletePhraseClick" Width="340"/>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <Button Content="安全エリア" Tag="SafeArea" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="180" Height="80" Opacity="0.6"/>
        </Grid>
    </DockPanel>
</Window>
